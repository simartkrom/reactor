generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model VideoProject {
  id          String   @id @default(uuid())
  topic       String
  status      String   @default("pending") // pending, generating, completed, failed
  error       String?
  currentStep String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  script      Script?
  images      Image[]
  audio       Audio?
  video       Video?
}

model Script {
  id        String   @id @default(uuid())
  projectId String   @unique
  project   VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

model Image {
  id        String   @id @default(uuid())
  projectId String
  project   VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prompt    String
  path      String
  order     Int
  createdAt DateTime @default(now())
}

model Audio {
  id        String   @id @default(uuid())
  projectId String   @unique
  project   VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String
  duration  Float?
  createdAt DateTime @default(now())
}

model Video {
  id        String   @id @default(uuid())
  projectId String   @unique
  project   VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String
  duration  Float?
  createdAt DateTime @default(now())
}
